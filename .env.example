# Gemini AI API Key
# Get from: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_API_KEY=your_gemini_api_key_here

# Firebase Configuration (optional, for saving conversations)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudflare Workers Proxy (for China users)
# Set to 'true' if you're in China and cannot access Google directly
VITE_USE_PROXY=true
VITE_GEMINI_PROXY_URL=https://gemini-live-proxy.chenmx9700.workers.dev
